# Twilio credentials — used as HTTP Basic auth against
# https://comms.twilio.com/v1/Emails
#
# These can be either:
#   - Account SID (starts with AC...) + Auth Token, OR
#   - API Key SID (starts with SK...) + API Key Secret  ← recommended for prod
# Both formats work; the env-var names below stay the same.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Email address that receives contact form submissions
CONTACT_RECIPIENT_EMAIL=atencion@centrodemedicinaregenerativa.com

# From-address for outgoing emails. Must be a verified Sender Identity in
# the Twilio Console. For new/trial accounts, the only pre-verified sender
# is <ACCOUNT_SID>@centrodemedicinaregenerativa.com — ugly but it works.
# To use a friendlier address (e.g. no-reply@...), add it as a Sender
# Identity in Twilio Console → Email → Senders.
CONTACT_FROM_EMAIL=
