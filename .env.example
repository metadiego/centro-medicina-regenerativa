# Twilio API Key credentials (Console → Account → API keys & tokens → Create API key)
# Used as HTTP Basic auth username:password against https://comms.twilio.com/v1/Emails
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# Email address that receives contact form submissions
CONTACT_RECIPIENT_EMAIL=atencion@centrodemedicinaregenerativa.com

# From-address for outgoing emails — MUST be a Twilio-verified sender
# (Console → Email → Senders → Verify a sender, or authenticate the domain)
CONTACT_FROM_EMAIL=no-reply@centrodemedicinaregenerativa.com
